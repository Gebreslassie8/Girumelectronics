import { NextResponse } from 'next/server';
import connectDB from '@/lib/db';
import { Receipt, Order } from '@/models';
import { requireAuth, requireRole } from '@/lib/auth';

export async function GET(req) {
  const { error } = await requireAuth(req);
  if (error) return error;

  await connectDB();
  const receipts = await Receipt.find({})
    .populate('branch', 'name code')
    .populate('order', 'orderNumber')
    .populate('issuedBy', 'fullName phone')
    .sort({ createdAt: -1 })
    .lean();
  return NextResponse.json(receipts);
}

export async function POST(req) {
  const { error, user } = await requireRole(req, 'admin', 'owner', 'seller');
  if (error) return error;

  try {
    await connectDB();
    const body = await req.json();
    const {
      orderNumber, productCode, itemType, customerName, customerPhone,
      prepayment, remainingPayment, totalPrice, appointmentDate,
      note, status, branch,
    } = body;

    if (!itemType || !customerName || !appointmentDate || totalPrice == null) {
      return NextResponse.json(
        { error: 'Missing required fields: itemType, customerName, appointmentDate, totalPrice' },
        { status: 400 }
      );
    }

    let resolvedBranch = branch;
    if (!resolvedBranch && user.branch) {
      resolvedBranch = typeof user.branch === 'object' ? user.branch._id : user.branch;
    }
    if (!resolvedBranch) {
      return NextResponse.json({ error: 'Branch is required' }, { status: 400 });
    }

    // Find linked order by orderNumber if provided
    let orderId = null;
    if (orderNumber) {
      const found = await Order.findOne({ orderNumber: orderNumber.trim() }).lean();
      if (found) orderId = found._id;
    }

    // Auto-generate receiptNumber (bypass broken Mongoose 8 hook)
    const year = new Date().getFullYear();
    const count = await Receipt.countDocuments({ receiptNumber: new RegExp('^RCP-' + year + '-') });
    const receiptNumber = 'RCP-' + year + '-' + String(count + 1).padStart(4, '0');

    const receipt = await Receipt.create({
      receiptNumber,
      order: orderId,
      productCode: productCode || undefined,
      itemType,
      customerName,
      customerPhone: customerPhone || undefined,
      prepayment: Number(prepayment) || 0,
      remainingPayment: Number(remainingPayment) || 0,
      totalPrice: Number(totalPrice) || 0,
      appointmentDate,
      note: note || undefined,
      status: status || 'active',
      issuedBy: user._id,
      branch: resolvedBranch,
    });

    await receipt.populate('branch', 'name code');
    await receipt.populate('order', 'orderNumber');
    await receipt.populate('issuedBy', 'fullName phone');

    return NextResponse.json(receipt, { status: 201 });
  } catch (err) {
    if (err.name === 'ValidationError') {
      const errs = {};
      for (const k of Object.keys(err.errors)) errs[k] = err.errors[k].message;
      console.error('[receipts:POST] validation:', errs);
      return NextResponse.json({ error: 'Validation failed', errors: errs }, { status: 400 });
    }
    if (err.code === 11000) {
      return NextResponse.json({ error: 'Duplicate receipt number, retry' }, { status: 409 });
    }
    console.error('[receipts:POST]', err);
    return NextResponse.json({ error: err.message || 'Create failed' }, { status: 500 });
  }
}
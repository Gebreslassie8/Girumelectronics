  "about": {
    "title": "ስለ እኛ",
    "subtitle": "ስለ ግሩም ምድጃ ታሪክ እና ተልዕኮ ይወቁ።",
    "storyTitle": "የእኛ ታሪክ",
    "storyP1": "ግሩም ምድጃ የተመሰረተው በ2014 ዓ.ም የኢትዮጵያ ቤተሰቦች የሚጠቀሙባቸውን ባህላዊ ምድጃዎች ወደ ዘመናዊ፣ ቆጣቢ እና ደህንነታቸው የተጠበቀ ምርቶች ለመቀየር በማሰብ ነው።",
    "storyP2": "ከአንድ ትንሽ ወርክሾፕ ተነስተን በአዲስ አበባ እና በአቅራቢያው አካባቢዎች 4 ቅርንጫፎች ያሉት ኩባንያ ሆነናል። በሺዎች የሚቆጠሩ ደንበኞችን በማገልገል በአካባቢው ገበያ የታመነ ስም ሆነናል።",
    "storyP3": "ጥራት ያላቸውን ምርቶች በተመጣጣኝ ዋጋ በማቅረብ የደንበኞቻችንን ፍላጎት ማሟላትን እንቀጥላለን።",
    "stats": {
      "founded": "የተመሰረተበት",
      "customers": "ደንበኞች",
      "branches": "ቅርንጫፎች",
      "employees": "ሠራተኞች"
    },
    "founderTitle": "መስራቹን ያውቁ",
    "founderSubtitle": "የኩባንያው ራዕይ ጀርባ ያለው ሰው",
    "founderName": "እሸቱ ተሻገር",
    "founderRole": "መስራች እና ዋና ስራ አስፈጻሚ",
    "founderQuote": "የጥራት ምርቶች እና ታማኝ አገልግሎት ማህበረሰቦችን ሊለውጡ ይችላሉ በሚል ቀላል እምነት ጀመርን።",
    "founderBio": "በችርቻሮ እና በማኑፋክቸሪንግ ከአስር ዓመት በላይ ልምድ ያለው እሸቱ፣ በ2014 ዓ.ም የታመኑ በአገር ውስጥ የተመረቱ ምርቶችን ለእያንዳንዱ የኢትዮጵያ ቤተሰብ ለማድረስ በሚል ተልዕኮ ኩባንያውን መሰረተ።",

import { NextResponse } from 'next/server';
import crypto from 'crypto';
import bcrypt from 'bcryptjs';
import mongoose from 'mongoose';
import jwt from 'jsonwebtoken';
import { OtpCode } from '@/models';
import { User } from '@/models';

const MAX_ATTEMPTS = 5;
const RESET_TOKEN_TTL = '10m';

async function connectDb() {
  if (mongoose.connection.readyState === 1) return;
  await mongoose.connect(process.env.MONGODB_URI);
}

function normalizePhone(p) {
  const s = String(p || '').replace(/\s+/g, '');
  if (/^\+?2519\d{8}$/.test(s)) return '0' + s.slice(-9);
  if (/^09\d{8}$/.test(s)) return s;
  if (/^9\d{8}$/.test(s)) return '0' + s;
  return s;
}

export async function POST(req) {
  try {
    await connectDb();
    const { phone: rawPhone, code } = await req.json();
    const phone = normalizePhone(rawPhone);

    if (!/^09\d{8}$/.test(phone)) {
      return NextResponse.json({ error: 'ትክክለኛ ስልክ ቁጥር ያስገቡ' }, { status: 400 });
    }
    if (!/^\d{6}$/.test(String(code || ''))) {
      return NextResponse.json({ error: '6 አሃዝ ኮድ ያስገቡ' }, { status: 400 });
    }

    // Find latest non-consumed, non-expired code
    const otp = await OtpCode.findOne({
      phone,
      purpose: 'reset_password',
      consumed: false,
      expiresAt: { $gt: new Date() },
    }).sort({ createdAt: -1 });

    if (!otp) {
      return NextResponse.json(
        { error: 'ኮዱ አልተገኘም ወይም ጊዜው አልፏል — እንደገና ይጠይቁ' },
        { status: 400 }
      );
    }

    if (otp.attempts >= MAX_ATTEMPTS) {
      otp.consumed = true;
      await otp.save();
      return NextResponse.json(
        { error: 'ብዙ ጊዜ ሞክረዋል — አዲስ ኮድ ይጠይቁ' },
        { status: 429 }
      );
    }

    const ok = await bcrypt.compare(String(code), otp.codeHash);
    if (!ok) {
      otp.attempts += 1;
      await otp.save();
      return NextResponse.json(
        { error: `የተሳሳተ ኮድ (${MAX_ATTEMPTS - otp.attempts} ሙከራ ቀርቷል)` },
        { status: 400 }
      );
    }

    // Correct code — consume it
    otp.consumed = true;
    await otp.save();

    // Issue short-lived reset token
    const user = await User.findOne({ phone });
    if (!user) {
      // Don't leak — return same error as wrong code
      return NextResponse.json({ error: 'የተሳሳተ ኮድ' }, { status: 400 });
    }

    const resetToken = jwt.sign(
      { sub: String(user._id), purpose: 'reset_password', phone },
      process.env.JWT_SECRET,
      { expiresIn: RESET_TOKEN_TTL }
    );

    return NextResponse.json({ ok: true, resetToken });
  } catch (err) {
    console.error('[verify-otp]', err);
    return NextResponse.json({ error: 'ስህተት ተፈጥሯል' }, { status: 500 });
  }
}